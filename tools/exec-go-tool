#!/bin/sh
if [ $# -lt 1 ]; then
  echo "usage: $0 <go-tool-package> [args...]" >&2
  exit 2
fi

WD=$(cd "$(dirname "$0")"; pwd)

if [ -n "${GOCACHEPROG:-}" ]; then
  # With an external cache, go tool -n may print a temporary executable path
  # that disappears when Go exits. Build an explicit output instead, keeping
  # the caller's working directory when running the tool.
  TOOL_DIR=$(mktemp -d) || exit 1
  trap 'rm -rf "$TOOL_DIR"' EXIT
  # Generators use the executable basename in their generated-code headers.
  TOOL="$TOOL_DIR/${1##*/}"
  (cd "$WD" && go build -o "$TOOL" "$1") || exit $?
  shift
  "$TOOL" "$@"
  exit $?
fi

TOOL=$(cd "$WD"; go tool -n "$1")
shift
exec "$TOOL" "$@"
